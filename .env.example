# Copiar a .env y rellenar. El .env NUNCA se sube a git.

# --- SQL Server ---
DB_HOST=servidor-sql
DB_PORT=1433
DB_NAME=nombre_bd
DB_USER=usuario_lectura
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
DB_TIMEOUT=5
# Descomentar solo si el SQL Server no soporta TLS 1.2 (error "SSL Provider ... unsupported protocol")
# OPENSSL_CONF=/app/openssl-legacy.cnf

# --- Código QR ---
QR_BASE_URL=http://172.16.7.9:9094/api/albaran/pdf
# Mínimo 32 caracteres. Debe ser el MISMO secreto con el que se generan los QR impresos.
QR_SIGNING_SECRET=
QR_SIGNATURE_REQUIRED=true

# --- Servicio ---
APP_PORT=9094
DOCS_ENABLED=false
